{
  "name": "@dtrw/shared",
  "private": true,
  "version": "0.0.1",
  "description": "Shared utils used in multiple projects",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --parallel --aggregate-output --no-bail run build",
    "typecheck": "pnpm -r --parallel --aggregate-output --no-bail run typecheck",
    "lint": "pnpm -r --parallel --aggregate-output --no-bail run lint",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "author": "Bartosz Dotryw <burtekdotryw@gmail.com>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "release-please": "^17.10.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
